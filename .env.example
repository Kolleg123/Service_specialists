# Public application URL (HTTPS in production)
APP_BASE_URL=https://example.com
APP_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=true

# SMTP settings. For Gmail: smtp.gmail.com:587 and a Google App Password.
# Keep this .env file private; never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Свободно.
