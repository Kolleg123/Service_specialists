# Local development (Gmail SMTP)
APP_BASE_URL=http://127.0.0.1:5000
# Use a private random secret of at least 32 characters. Keep an existing valid value.
# An empty value uses the private key in instance/session.key.
APP_SECRET=
COOKIE_SECURE=false

# Gmail: use a Google App Password, NOT your normal Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_FROM_NAME=Свободно.

# Ordinary mode preserves instance/svobodno.sqlite. A separate demo file is seeded.
DEMO_MODE=false
# DATABASE_PATH=instance/svobodno.sqlite
# DEMO_DATABASE_PATH=instance/svobodno-demo.sqlite
# Set only if this exact Nginx peer overwrites X-Forwarded-For and X-Forwarded-Proto.
# TRUSTED_PROXY_IPS=127.0.0.1

# Optional YooKassa test shop. Keep real credentials out of Git.
PAYMENTS_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://127.0.0.1:5000/?payment_return=1#dashboard
YOOKASSA_WEBHOOK_TOKEN=

# External notifications: test adapter by default, webhook only when explicitly enabled
NOTIFICATION_ADAPTER=test
TEST_NOTIFICATION_SINK=instance/outgoing-notifications.jsonl
NOTIFICATION_WEBHOOK_URL=
